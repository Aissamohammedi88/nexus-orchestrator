class Handler(BaseHTTPRequestHandler):
server_version = "NexusWebForge/" + VERSION
protocol_version = "HTTP/1.1"
orchestrator: ForgeOrchestrator = None

def log_message(self, *a): pass

def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
if isinstance(body, str): body = body.encode("utf-8")
Essayez:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-cache")
if extra:
for k,v in extra.items(): self.send_header(k, v)
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError): pass

def _json(self, code, obj):
try: body = json.dumps(obj, ensure_ascii=False, default=str)
except Exception: body = "{}"
self._send(code, body, "application/json; charset=utf-8")

def _read_json(self):
Essayez:
n = int(self.headers.get("Content-Length", 0))
if n == 0: return {}
return json.loads(self.rfile.read(n).decode("utf-8"))
except Exception: return {}

def do_GET(self):
parsed = urllib.parse.urlparse(self.path)
path = parsed.path
q = urllib.parse.parse_qs(parsed.query)

if path in ("/", "/index.html"):
return self._send(200, HTML.replace("__V__", VERSION))

si chemin == "/api/moteurs":
return self._json(200, {
"v0": self.orchestrator.v0.has_key,
"lovable": self.orchestrator.lovable.has_key,
"bolt": False, # pas d'API
"demo": True,
})

if path == "/api/file":
pid = q.get("project", [None])[0]
name = q.get("name", [None])[0]
if not pid or not name:
return self._json(400, {"error": "project et name requis"})
project = self.orchestrator.projects.get(pid) or _MEM_PROJECTS.get(pid)
if not project:
return self._json(404, {"error": "projet introuvable"})
content = project.get("files", {}).get(name, "")
return self._json(200, {"name": name, "content": content})

if path == "/api/zip":
pid = q.get("id", [None])[0]
if not pid:
return self._json(400, {"error": "id requis"})
zip_path = self.orchestrator.export_zip(pid)
if not zip_path or not zip_path.exists():
return self._json(404, {"error": "zip introuvable"})
data = zip_path.read_bytes()
return self._send(200, data, "application/zip",
{"Content-Disposition": f'attachment; filename="{pid}.zip"'})

return self._json(404, {"error": "not found"})

def do_POST(self):
parsed = urllib.parse.urlparse(self.path)
if parsed.path == "/api/forge":
payload = self._read_json()
prompt = (payload.get("prompt") or "").strip()
engine = (payload.get("engine") or "auto").strip()
if not prompt:
return self._json(400, {"error": "prompt requis"})
result = self.orchestrator.create(prompt, engine)
return self._json(200, result)
return self._json(404, {"error": "not found"})


